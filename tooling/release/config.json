{
  "legacy": {
    "start": [
      "./scripts/start.sh"
    ],
    "stop": [
      "./scripts/stop.sh"
    ],
    "status": [
      "./scripts/status.sh"
    ]
  },
  "prepare": [
    [
      "npm",
      "ci"
    ],
    [
      "npm",
      "run",
      "check:dependencies"
    ],
    [
      "npm",
      "run",
      "typecheck"
    ],
    [
      "npm",
      "run",
      "build"
    ],
    [
      "npm",
      "run",
      "check:bundle"
    ]
  ],
  "outputs": [
    "src/server.js",
    "dist/app.js",
    "dist/app.css",
    "dist/manifest.json",
    "dist/app.js.map",
    "dist/app.css.map"
  ],
  "persistent": [],
  "runtimeFiles": [
    ".env",
    ".env.local",
    ".env.production"
  ],
  "exclude": [],
  "toolchain": [
    [
      "node",
      "--version"
    ]
  ],
  "startupTimeoutSec": 180,
  "patches": [],
  "panel": true
}
